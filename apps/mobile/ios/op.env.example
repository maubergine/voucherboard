# Where the iOS app's TestFlight signing material lives in 1Password, as secret references (op://vault/item/field).
# Copy to op.env (gitignored) and replace each reference with your own: 1Password > the field or file > Copy Secret
# Reference. Read by scripts/ios-secrets.sh, which copies it into a GitHub environment.
# Attached files are read by file name.
#
# One item for the certificate: the Team ID, the .p12 and its password, and the three App Store profiles attached.
VB_OP_TEAM_ID="op://Vault/iOS distribution certificate/team id"
VB_OP_P12="op://Vault/iOS distribution certificate/certificate.p12"
VB_OP_P12_PASSWORD="op://Vault/iOS distribution certificate/password"
VB_OP_PROFILE_APP="op://Vault/iOS distribution certificate/app.mobileprovision"
VB_OP_PROFILE_SHARE="op://Vault/iOS distribution certificate/share.mobileprovision"
VB_OP_PROFILE_LIVE="op://Vault/iOS distribution certificate/live.mobileprovision"
# One for the App Store Connect API key (App Manager): its Key ID, Issuer ID and the .p8 attached.
VB_OP_ASC_KEY_ID="op://Vault/App Store Connect upload key/key id"
VB_OP_ASC_ISSUER_ID="op://Vault/App Store Connect upload key/issuer id"
VB_OP_ASC_P8="op://Vault/App Store Connect upload key/AuthKey.p8"
