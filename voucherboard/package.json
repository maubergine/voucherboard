{
  "name": "voucherboard",
  "version": "0.6.2",
  "private": true,
  "author": "Marius Rubin",
  "license": "UNLICENSED",
  "description": "Browser extension that gives the Lewisham visitor parking permit site a better booking planner.",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "package": "node scripts/package.mjs",
    "package:firefox": "node scripts/package-firefox.mjs",
    "lint:firefox": "node scripts/package-firefox.mjs --dir dist/firefox && web-ext lint --source-dir dist/firefox",
    "dev": "scripts/dev.sh",
    "validate-manifest": "node scripts/validate-manifest.mjs",
    "commitlint": "commitlint",
    "semantic-release": "semantic-release",
    "guide": "node scripts/render-guide.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "jsdom": "30.1.1",
    "semantic-release": "25.0.9",
    "web-ext": "10.7.0"
  }
}
