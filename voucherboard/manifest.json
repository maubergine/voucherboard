{
  "manifest_version": 3,
  "name": "Voucherboard Beta",
  "version": "0.1.0",
  "version_name": "0.1.0 beta",
  "description": "Beta. A clearer planner for Lewisham visitor parking vouchers. Runs only on the council's permit site, in your own logged-in session.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://parkingpermits.lewisham.gov.uk/*"
      ],
      "exclude_matches": [
        "https://parkingpermits.lewisham.gov.uk/PermitPayment/*",
        "https://parkingpermits.lewisham.gov.uk/VoucherBuyAgain/*",
        "https://parkingpermits.lewisham.gov.uk/Account/*"
      ],
      "js": [
        "src/zones.js",
        "src/planner.js",
        "src/portal.js",
        "src/terms.js",
        "src/app.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/app.css",
        "guide/*",
        "guide/img/*"
      ],
      "matches": [
        "https://parkingpermits.lewisham.gov.uk/*"
      ]
    }
  ],
  "author": "Marius Rubin"
}
